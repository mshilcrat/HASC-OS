var ROLE={rm:{name:"Residence Manager",c:"#568E62"},ac:{name:"Area Coordinator",c:"#C96A44"},admin:{name:"Admin",c:"#17a2b8"}};
var AC_EMAILS=["arosenzweig@hasccenter.org","ssinger@hasccenter.org","llebovits@hasccenter.org","slieber@hasccenter.org"];
var ADMIN_EMAILS=["mshilcrat@hasccenter.org"];
function resolveRole(email,role){role=(role||"").toLowerCase();email=(email||"").toLowerCase();
 if(role==="admin"||ADMIN_EMAILS.indexOf(email)>=0)return "admin";
 if(role==="area_coordinator"||AC_EMAILS.indexOf(email)>=0)return "ac";return "rm";}
function initials(e){var b=(e||"").split("@")[0].replace(/[._-]+/g," ").trim();var p=b.split(" ").filter(Boolean);return ((p[0]||"?")[0]+(p.length>1?p[p.length-1][0]:"")).toUpperCase();}
function cap(e){var n=(e||"").split("@")[0].replace(/[._-]+/g," ");return n.charAt(0).toUpperCase()+n.slice(1);}
function greeting(){var h=new Date().getHours();return h<12?"Good morning":h<17?"Good afternoon":"Good evening";}
function today(){return new Date().toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric',year:'numeric'});}
function clock(){return new Date().toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'});}
function homeOptions(){var o="";for(var i=0;i<HOMES.length;i++){o+='<option value="'+i+'"'+(i===HOME_IDX?" selected":"")+'>'+HOMES[i].name+'</option>';}return o;}

var WMO={0:"Clear",1:"Mainly clear",2:"Partly cloudy",3:"Overcast",45:"Fog",48:"Rime fog",51:"Light drizzle",53:"Drizzle",55:"Heavy drizzle",61:"Light rain",63:"Rain",65:"Heavy rain",66:"Freezing rain",67:"Freezing rain",71:"Light snow",73:"Snow",75:"Heavy snow",77:"Snow grains",80:"Light showers",81:"Showers",82:"Heavy showers",85:"Snow showers",86:"Snow showers",95:"Thunderstorm",96:"Thunderstorm",99:"Thunderstorm"};
function loadWeather(){
  var h=HOMES[HOME_IDX]; var el=document.getElementById("wx"); if(!el||!h)return;
  var url="https://api.open-meteo.com/v1/forecast?latitude="+h.lat+"&longitude="+h.lng+"&current=temperature_2m,weather_code,wind_speed_10m&temperature_unit=fahrenheit&wind_speed_unit=mph&timezone=America%2FNew_York";
  fetch(url).then(function(r){return r.json();}).then(function(d){
    var c=d&&d.current?d.current:null; if(!c){throw 0;}
    var t=Math.round(c.temperature_2m); var cond=WMO[c.weather_code]||"\u2014"; var wind=Math.round(c.wind_speed_10m);
    el.innerHTML='<div class="wxtop">'+ICONS.wx+' Local weather</div>'
      +'<div><div class="wxmid"><span class="wxtemp">'+t+'</span><span class="wxdeg">\u00b0F</span></div>'
      +'<div class="wxcond">'+cond+'</div></div>'
      +'<div class="wxmeta">'+(h.zip?"Brooklyn "+h.zip:h.name)+'<br>Wind '+wind+' mph</div>';
  }).catch(function(){
    el.innerHTML='<div class="wxtop">'+ICONS.wx+' Local weather</div><div class="wxloading">Weather unavailable right now.</div>';
  });
}

var SESSION=null,sb=null;
(function start(){
 if(window.supabase&&window.HASC_CONFIG){try{
   sb=window.supabase.createClient(window.HASC_CONFIG.SUPABASE_URL,window.HASC_CONFIG.SUPABASE_ANON_KEY);window.__hascClient=sb;
   sb.auth.getSession().then(function(res){var s=res&&res.data?res.data.session:null;
     if(!s){renderGate();return;}var email=(s.user&&s.user.email||"").toLowerCase();
     return sb.from("profiles").select("role").eq("id",s.user.id).single().then(function(p){
       SESSION={email:email,role:resolveRole(email,p&&p.data?p.data.role:"")};renderApp();
     }).catch(function(){SESSION={email:email,role:resolveRole(email,"")};renderApp();});
   }).catch(renderGate);return;
 }catch(e){}}
 renderGate();
})();
function renderGate(){
 var app=document.getElementById("app");
 app.innerHTML='<div class="login"><div class="lcard"><div class="lg"><img src="'+LOGO+'" alt="HASC Center"></div>'
  +'<h1>Welcome back</h1><p class="sub">Sign in to continue.</p>'
  +'<div class="fld"><label>Email</label><input id="email" type="email" placeholder="you@hasccenter.org"></div>'
  +'<div class="fld"><label>Password</label><input id="password" type="password" placeholder="Password"></div>'
  +'<button class="lbtn" id="go">Sign in</button><div class="lerr" id="err"></div><div class="lfoot">HASC Center</div></div></div>';
 var go=document.getElementById("go"),err=document.getElementById("err");
 function submit(){var email=(document.getElementById("email").value||"").trim();var pw=document.getElementById("password").value||"";
   err.textContent="";if(!email||email.indexOf("@")<0){err.textContent="Enter a valid email.";return;}
   if(pw.length<4){err.textContent="Check your password and try again.";return;}
   go.disabled=true;go.textContent="Signing in\u2026";
   if(sb&&sb.auth&&sb.auth.signInWithPassword){
     sb.auth.signInWithPassword({email:email,password:pw}).then(function(res){
       if(res&&res.error){err.textContent=res.error.message||"Sign in failed.";go.disabled=false;go.textContent="Sign in";return;}
       var uid=res&&res.data&&res.data.user?res.data.user.id:null;
       if(uid){sb.from("profiles").select("role").eq("id",uid).single().then(function(p){
          SESSION={email:email.toLowerCase(),role:resolveRole(email.toLowerCase(),p&&p.data?p.data.role:"")};renderApp();
        }).catch(function(){SESSION={email:email.toLowerCase(),role:resolveRole(email.toLowerCase(),"")};renderApp();});
       }else{SESSION={email:email.toLowerCase(),role:resolveRole(email.toLowerCase(),"")};renderApp();}
     }).catch(function(){err.textContent="Sign in failed.";go.disabled=false;go.textContent="Sign in";});
   }else{SESSION={email:email.toLowerCase(),role:resolveRole(email.toLowerCase(),"")};renderApp();}
 }
 go.addEventListener("click",submit);
 document.getElementById("app").addEventListener("keydown",function(e){if(e.key==="Enter")submit();});
 document.getElementById("email").focus();
}
