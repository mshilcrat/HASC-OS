<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HASC Residential OS</title><style>@font-face{font-family:'Plus Jakarta Sans';font-style:normal;font-weight:500;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');}@font-face{font-family:'Plus Jakarta Sans';font-style:normal;font-weight:600;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');}@font-face{font-family:'Plus Jakarta Sans';font-style:normal;font-weight:700;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');}@font-face{font-family:'Plus Jakarta Sans';font-style:normal;font-weight:800;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');}
:root{
  --ui:'Plus Jakarta Sans',-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
  --paper:#f1efe9; --card:#fff; --ink:#233038; --ink2:#3a4a54; --muted:#6a7a84; --faint:#9fb0b8; --line:#e7e2d9; --line2:#eef1f4;
  --teal:#17a2b8; --teal-ink:#0f7d8f; --teal-wash:#e8f6f8;
  --green:#568E62; --green-ink:#39684a; --green-wash:#eef4ef;
  --blue:#3E9EB3; --blue-ink:#2f7d90; --blue-wash:#e9f4f6;
  --plum:#AC659D; --plum-ink:#7c4470; --plum-wash:#f6eff4;
  --gold:#D9B93B; --gold-ink:#8a7415; --gold-wash:#fbf6e4;
  --coral:#C96A44; --coral-ink:#9a4a2b; --coral-wash:#f9ede7;
  --amber:#E0A83E; --red:#D96A54;
  --sh:0 1px 2px rgba(60,50,35,.05),0 12px 30px -18px rgba(60,50,35,.20);
}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%}
body{font-family:var(--ui);background:var(--paper);color:var(--ink);-webkit-font-smoothing:antialiased;letter-spacing:-.01em}
button{font-family:inherit;cursor:pointer}svg{display:block}a{text-decoration:none;color:inherit}
a:focus-visible,button:focus-visible,input:focus-visible{outline:2px solid var(--teal);outline-offset:2px;border-radius:8px}

/* top strip */
.topbar{background:var(--card);border-bottom:1px solid var(--line);display:flex;align-items:center;gap:16px;padding:14px 34px;position:sticky;top:0;z-index:10}
.topbar .logo img{height:36px;display:block}
.topbar .rule{width:1px;height:26px;background:var(--line)}
.topbar .brandlabel{font-size:12px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:var(--rolec,#17a2b8)}
.topbar .right{margin-left:auto;display:flex;align-items:center;gap:16px}
.iconbtn{position:relative;width:38px;height:38px;border-radius:11px;border:1px solid var(--line);background:var(--card);color:var(--muted);display:grid;place-items:center}
.iconbtn svg{width:18px;height:18px}.iconbtn:hover{border-color:var(--teal);color:var(--teal)}
.iconbtn .cnt{position:absolute;top:-6px;right:-6px;min-width:18px;height:18px;padding:0 5px;border-radius:9px;background:var(--red);color:#fff;font-size:11px;font-weight:800;display:grid;place-items:center}
.clock{text-align:right;line-height:1.25}.clock .d{font-size:12.5px;font-weight:700;color:var(--ink2)}.clock .t{font-size:12px;color:var(--faint);font-weight:600}
.me{display:flex;align-items:center;gap:10px;padding-left:16px;border-left:1px solid var(--line)}
.me .badge{width:38px;height:38px;border-radius:11px;display:grid;place-items:center;font-size:14px;font-weight:800;color:#fff;background:var(--rolec,#17a2b8)}
.me .nm{font-size:14px;font-weight:700}.me .rl{font-size:10.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--faint)}
.me .out{margin-left:6px;width:34px;height:34px;border-radius:10px;border:1px solid var(--line);display:grid;place-items:center;color:var(--muted);background:var(--card)}
.me .out svg{width:16px;height:16px}.me .out:hover{border-color:var(--teal);color:var(--teal)}

/* header */
.shell{max-width:1240px;margin:0 auto;padding:30px 34px 60px}
.hello{display:flex;align-items:flex-end;gap:14px;margin-bottom:2px}
.hello h1{font-size:30px;font-weight:800;letter-spacing:-.03em;margin:0}
.hello .wave{font-size:26px}
.hellosub{color:var(--muted);font-size:15px;margin:0 0 26px}
.hellosub b{color:var(--ink2);font-weight:700}

.cols{display:grid;grid-template-columns:1fr 348px;gap:24px;align-items:start}
@media (max-width:1080px){.cols{grid-template-columns:1fr}}

/* residence card */
.res{display:grid;grid-template-columns:270px 1fr;gap:0;background:var(--card);border:1px solid var(--line);border-radius:20px;overflow:hidden;box-shadow:var(--sh);margin-bottom:24px}
.wx{position:relative;background:linear-gradient(160deg,#5aa9c4,#2f7d97);color:#fff;padding:22px 24px;display:flex;flex-direction:column;justify-content:space-between;min-height:210px}
.wx .wxtop{display:flex;align-items:center;gap:8px;font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;opacity:.9}
.wx .wxtop svg{width:16px;height:16px}
.wx .wxmid{display:flex;align-items:flex-start;gap:6px}
.wx .wxtemp{font-size:52px;font-weight:800;line-height:.9;letter-spacing:-.03em}
.wx .wxdeg{font-size:20px;font-weight:800;margin-top:4px}
.wx .wxcond{font-size:15px;font-weight:700;margin-top:6px}
.wx .wxmeta{font-size:12.5px;opacity:.9;font-weight:600;line-height:1.6}
.wx .wxloading{font-size:13px;opacity:.85;font-weight:600}
@media (max-width:680px){.res{grid-template-columns:1fr}.wx{min-height:150px}}

.res .photo{position:relative;background:linear-gradient(150deg,#7fa88b,#4f7d63);min-height:210px}
.res .photo::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent,rgba(20,30,25,.22))}
.res .photo .roof{position:absolute;inset:0;display:grid;place-items:center;color:rgba(255,255,255,.9)}
.res .photo .roof svg{width:64px;height:64px;opacity:.9}
.res .body{padding:24px 26px;display:flex;flex-direction:column}
.res .ey{display:inline-flex;align-items:center;gap:7px;font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}
.res .ey svg{width:15px;height:15px}
.res h2{font-size:24px;font-weight:800;letter-spacing:-.02em;margin:0 0 12px}
.res .chip{align-self:flex-start;font-size:12px;font-weight:800;color:var(--green-ink);background:var(--green-wash);padding:4px 11px;border-radius:999px;margin-bottom:14px}
.res .msg{font-size:14px;color:var(--teal-ink);font-weight:700;line-height:1.5;margin:0 0 18px}
.res .cta{margin-top:auto;display:inline-flex;align-items:center;justify-content:space-between;gap:12px;background:var(--teal);color:#fff;font-weight:800;font-size:14px;padding:13px 20px;border-radius:12px;border:0;width:100%}
.res .cta svg{width:18px;height:18px}
.res .cta:hover{background:var(--teal-ink)}
.res .reshead{display:flex;align-items:center;gap:12px;justify-content:space-between;margin-bottom:12px}
.res .reshead h2{margin:0}
.homepick{font:600 12.5px var(--ui);color:var(--ink2);background:var(--paper);border:1px solid var(--line);border-radius:9px;padding:6px 8px;max-width:150px}
.resmeta{display:flex;flex-wrap:wrap;gap:8px 18px;margin-bottom:10px}
.resmeta span{font-size:13px;color:var(--ink2)}.resmeta b{color:var(--muted);font-weight:800;font-size:11px;text-transform:uppercase;letter-spacing:.06em;margin-right:5px}
.resaddr{font-size:12.5px;color:var(--muted);margin:0 0 16px;line-height:1.5}


/* my apps */
.sec{font-size:13px;font-weight:800;letter-spacing:.04em;color:var(--ink2);margin:0 0 14px;display:flex;align-items:center;gap:10px}
.sec .ln{flex:1;height:1px;background:var(--line)}
.apps{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
.app{position:relative;display:flex;flex-direction:column;background:var(--card);border:1px solid var(--line);border-radius:16px;padding:20px;cursor:pointer;transition:transform .16s,box-shadow .16s,border-color .16s;box-shadow:0 1px 2px rgba(60,50,35,.04)}
.app:hover{transform:translateY(-3px);box-shadow:var(--sh);border-color:transparent}
.app .plate{width:48px;height:48px;border-radius:13px;display:grid;place-items:center;color:#fff;background:var(--c);box-shadow:0 8px 18px -9px var(--c);margin-bottom:14px}
.app .plate svg{width:24px;height:24px}
.app h3{font-size:16px;font-weight:800;letter-spacing:-.01em;margin:0 0 5px}
.app p{font-size:13px;color:var(--muted);line-height:1.5;margin:0;flex:1}
.app .stat{margin-top:14px;align-self:flex-start;font-size:12px;font-weight:800;padding:4px 10px;border-radius:999px}
.app .stat.on{color:var(--cink);background:var(--wash)}
.app .stat.dev{color:var(--faint);background:#f1f1ee}
.addapps{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:16px}
.addapp{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;padding:20px;border:1.5px dashed #d3ccbf;border-radius:14px;color:var(--faint);background:transparent;cursor:pointer;min-height:96px}
.addapp .pl{width:34px;height:34px;border-radius:10px;border:1.5px dashed #d3ccbf;display:grid;place-items:center}
.addapp .pl svg{width:18px;height:18px}
.addapp span{font-size:12.5px;font-weight:700}
.addapp:hover{border-color:var(--teal);color:var(--teal)}.addapp:hover .pl{border-color:var(--teal)}

/* right rail */
.rail{display:flex;flex-direction:column;gap:20px}
.panel{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:20px;box-shadow:0 1px 2px rgba(60,50,35,.04)}
.panel .ph{display:flex;align-items:center;gap:9px;font-size:13.5px;font-weight:800;margin-bottom:16px;color:var(--ink)}
.panel .ph svg{width:17px;height:17px;color:var(--teal)}
.panel .ph .link{margin-left:auto;font-size:12px;font-weight:800;color:var(--teal);cursor:pointer}
.glance{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.gcell{text-align:center;border-radius:13px;padding:12px 6px;background:var(--gw)}
.gcell .gi{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;margin:0 auto 8px;color:var(--gc)}
.gcell .gi svg{width:19px;height:19px}
.gcell .gn{font-size:22px;font-weight:800;line-height:1;color:var(--ink)}
.gcell .gl{font-size:11px;font-weight:700;color:var(--muted);margin-top:5px;line-height:1.25}
.prog .bar{height:8px;border-radius:99px;background:#eceae4;overflow:hidden;margin:6px 0 8px}
.prog .fill{height:100%;border-radius:99px;background:linear-gradient(90deg,var(--teal),var(--blue))}
.prog .row{display:flex;justify-content:space-between;align-items:center}
.prog .row .p1{font-size:13px;font-weight:800;color:var(--teal-ink)}
.prog .row .p2{font-size:20px;font-weight:800}
.prog .cap{font-size:12.5px;color:var(--muted);margin-top:4px}
.act{display:flex;flex-direction:column;gap:2px}
.act .item{display:flex;gap:12px;padding:11px 0;border-top:1px solid var(--line2)}
.act .item:first-child{border-top:0}
.act .ic{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;flex:none;color:var(--ac);background:var(--aw)}
.act .ic svg{width:17px;height:17px}
.act .tx{flex:1;min-width:0}
.act .t1{font-size:13.5px;font-weight:700;line-height:1.35}
.act .t2{font-size:12px;color:var(--muted);margin-top:2px}
.act .tm{font-size:11.5px;color:var(--faint);font-weight:700;white-space:nowrap}
.ann{background:linear-gradient(135deg,var(--teal-wash),#eaf6f8);border:1px solid #d5edf1;border-radius:14px;padding:14px 16px}
.ann .a1{font-size:13.5px;font-weight:800;color:var(--teal-ink);display:flex;align-items:center;gap:8px}
.ann .a1 svg{width:16px;height:16px}
.ann .a2{font-size:12.5px;color:var(--ink2);margin-top:6px;line-height:1.5}

/* login */
.login{position:fixed;inset:0;display:grid;place-items:center;overflow:auto;background:var(--paper)}
.lcard{width:100%;max-width:400px;background:var(--card);border:1px solid var(--line);border-radius:20px;box-shadow:0 12px 40px -16px rgba(34,48,56,.2);padding:40px 36px 32px;text-align:center}
.lcard .lg{margin-bottom:22px}.lcard .lg img{height:46px}
.lcard h1{font-size:22px;font-weight:800;letter-spacing:-.02em;margin:0 0 4px}.lcard .sub{color:var(--muted);font-size:14px;margin:0 0 26px}
.fld{margin-bottom:16px;text-align:left}.fld label{display:block;font-size:12px;font-weight:700;color:var(--muted);margin-bottom:6px}
.fld input{width:100%;padding:11px 13px;border:1px solid var(--line);border-radius:11px;font:600 14px var(--ui);color:var(--ink);background:#fbfdfe}
.fld input:focus{outline:none;border-color:var(--teal);box-shadow:0 0 0 3px rgba(23,162,184,.16)}
.lbtn{width:100%;margin-top:6px;padding:12px;border:0;border-radius:11px;color:#fff;font-weight:800;font-size:14px;background:var(--teal)}
.lbtn:hover{filter:brightness(1.06)}.lerr{color:#c0392b;font-size:13px;font-weight:700;margin-top:14px;min-height:18px}
.lfoot{font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--faint);margin-top:20px}
@media (max-width:680px){.res{grid-template-columns:1fr}.apps{grid-template-columns:1fr}.shell{padding:22px 18px 48px}.topbar{padding:12px 18px}}
