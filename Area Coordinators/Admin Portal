<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HASC OS — AC Checklist Admin</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcode-generator/1.4.4/qrcode.min.js"></script>
<script src="/wb-config.js"></script>
<style>
  :root{
    --ui:'Plus Jakarta Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
    --teal:#37C1CF; --teal-dk:#2aa3b0; --yellow:#F5CF01;
    --ink:#1f2d33; --muted:#5c6b72; --faint:#9fb0b8; --line:#e3ebee; --card:#ffffff;
    --red:#c0392b; --red-bg:#fdecea; --green:#1f7a45; --green-bg:#eafbf1; --teal-wash:#e8f6f8;
  }
  *{box-sizing:border-box}
  html,body{margin:0;padding:0;background:transparent}
  body{font-family:var(--ui);color:var(--ink);line-height:1.5;-webkit-font-smoothing:antialiased;letter-spacing:-.01em}
  button,select,textarea,input{font:inherit}
  button{cursor:pointer}
  .wrap{max-width:900px;margin:0 auto;padding:16px 16px 90px}

  .nav{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:2px 0 16px}
  .nav button{border:1px solid var(--line);background:#fff;color:var(--muted);border-radius:9px;padding:9px 15px;font-size:14px;font-weight:800}
  .nav button.on{background:var(--teal);border-color:var(--teal);color:#fff}
  .nav button:hover:not(.on){border-color:var(--teal);color:var(--teal-dk)}

  .btn{border:0;border-radius:10px;padding:12px 22px;font-size:15px;font-weight:800}
  .btn-teal{background:var(--teal);color:#fff}
  .btn-teal:hover{background:var(--teal-dk)}
  .btn-ghost{background:#fff;color:var(--teal-dk);border:1px solid var(--teal)}
  .btn-ghost:hover{background:var(--teal-wash)}
  .btn-danger{background:#fff;color:var(--red);border:1px solid var(--red)}
  .btn-danger:hover{background:var(--red-bg)}
  .row{display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-top:12px}

  /* cards / records / qr shared */
  .card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:20px 24px}
  .card h2{font-size:18px;margin:0 0 6px;color:var(--teal-dk)}
  .card .lab{font-size:13px;color:var(--muted);margin:0 0 12px}
  .fld{display:block;font-size:13px;font-weight:700;color:var(--muted);margin:12px 0 6px}
  .card input[type=text],.card textarea{width:100%;padding:11px 12px;border:1px solid var(--line);border-radius:9px;font-family:inherit;font-size:15px;outline:none}
  .card select{width:100%;padding:12px;border:1px solid var(--line);border-radius:9px;font-size:15px;font-family:inherit;background:#fff;outline:none}
  .card input:focus,.card textarea:focus,.card select:focus{border-color:var(--teal);box-shadow:0 0 0 3px var(--teal-wash)}
  table{width:100%;border-collapse:collapse;font-size:14px}
  th,td{text-align:left;padding:9px 8px;border-bottom:1px solid var(--line)}
  th{color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.4px}
  .filters{display:flex;gap:10px;flex-wrap:wrap;margin:6px 0 14px}
  .filters input,.filters select{padding:10px 12px;border:1px solid var(--line);border-radius:9px;font-size:14px;font-family:inherit;background:#fff;outline:none}
  .filters input{flex:1 1 220px;min-width:180px}
  .empty{color:var(--muted);font-size:14px;padding:10px 0}
  .fromqr{font-size:11px;font-weight:700;color:var(--green);margin-left:8px}

  /* single QR */
  .qrempty{text-align:center;color:var(--muted);padding:30px 10px;font-size:14px}
  .qrcard{text-align:center;margin-top:2px}
  .qrcard .qname{font-weight:800;font-size:20px;margin:2px 0 4px}
  .qsince{font-size:12px;color:var(--muted);margin-bottom:14px}
  .qsince b{color:var(--green)}
  .qrbox{display:inline-block;padding:14px;background:#fff;border:1px solid var(--line);border-radius:12px}
  .qrbox svg{width:230px;height:230px;display:block}
  .qurl{font-size:11px;color:var(--muted);word-break:break-all;margin:12px auto 0;max-width:420px}
  .qrow{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;margin-top:18px}
  .status{font-size:12px;font-weight:700;padding:3px 9px;border-radius:99px;display:inline-block;margin-top:10px}
  .status.saved{background:var(--green-bg);color:var(--green)}
  .status.preview{background:#fff6d6;color:#8a6d00;border:1px solid var(--yellow)}
  .status.err{background:var(--red-bg);color:var(--red)}
  .note{font-size:12px;color:var(--muted);margin-top:14px;line-height:1.5}
  .confirm{background:var(--red-bg);border:1px solid #f0b7b0;border-radius:10px;padding:14px 16px;margin-top:16px;font-size:13px}
  .confirm b{color:var(--red)}
  /* bulk QR */
  .qrgrid{display:flex;flex-wrap:wrap;gap:18px;margin-top:18px}
  .qrgcard{border:1px solid var(--line);border-radius:12px;padding:16px;text-align:center;width:230px;background:#fff}
  .qrgcard .gname{font-weight:700;font-size:15px;margin-bottom:10px}
  .qrgcard svg{width:180px;height:180px}
  .qrgcard .gurl{font-size:10px;color:var(--muted);word-break:break-all;margin-top:8px}
  .qrgcard .greset{margin-top:10px;font-size:12px;color:var(--red);background:none;border:0;font-weight:700;cursor:pointer}

  /* task builder */
  .cl-topbar{display:flex;flex-wrap:wrap;gap:18px;align-items:flex-end;margin:2px 0 16px}
  .cl-topbar label{display:flex;flex-direction:column;font-size:11px;font-weight:800;letter-spacing:.04em;color:var(--muted);gap:6px}
  .cl-topbar select{padding:11px 12px;border:1px solid var(--line);border-radius:9px;font-size:15px;min-width:240px;background:#fff;font-family:inherit;outline:none}
  .cl-topbar select:focus{border-color:var(--teal);box-shadow:0 0 0 3px var(--teal-wash)}
  .cl-add{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px;margin-bottom:18px;display:flex;flex-wrap:wrap;gap:10px;align-items:center}
  .cl-add input,.cl-add select{padding:10px 12px;border:1px solid var(--line);border-radius:9px;font-size:14px;font-family:inherit;outline:none}
  .cl-add input[type=text]{flex:1;min-width:180px}
  .cl-add input:focus,.cl-add select:focus{border-color:var(--teal);box-shadow:0 0 0 3px var(--teal-wash)}
  .cl-add .btn{padding:11px 18px}
  .cl-builder{display:grid;grid-template-columns:1fr auto 1fr;gap:16px;align-items:start}
  .cl-pane{background:var(--card);border:1px solid var(--line);border-radius:12px;display:flex;flex-direction:column;min-height:360px}
  .cl-pane-h{display:flex;justify-content:space-between;align-items:center;padding:14px 16px;border-bottom:1px solid var(--line);font-weight:800;font-size:15px}
  .cl-cnt{background:#eef3f4;color:var(--muted);border-radius:999px;padding:2px 11px;font-size:13px;font-weight:700}
  .cl-list{flex:1;overflow-y:auto;max-height:460px;padding:8px}
  .cl-opt{display:flex;align-items:flex-start;gap:10px;padding:9px 10px;border-radius:8px;cursor:pointer;font-size:14px}
  .cl-opt:hover{background:#f5fbfc}
  .cl-opt input{margin-top:3px}
  .cl-name{flex:1;line-height:1.35;font-weight:600}
  .cl-tag{font-size:10px;font-weight:800;letter-spacing:.04em;color:var(--faint);white-space:nowrap;text-transform:uppercase;padding-top:2px}
  .cl-mid{display:flex;flex-direction:column;gap:10px;justify-content:center;align-self:center;padding-top:40px}
  .cl-mid button{background:#fff;border:1px solid var(--line);border-radius:9px;padding:10px 14px;font-size:13px;font-weight:700;white-space:nowrap;color:var(--ink)}
  .cl-mid button:hover{background:var(--teal-wash);border-color:var(--teal);color:var(--teal-dk)}
  .cl-empty{color:var(--faint);text-align:center;padding:40px 16px;font-size:13px}
  @media(max-width:760px){.cl-builder{grid-template-columns:1fr}.cl-mid{flex-direction:row;flex-wrap:wrap;padding-top:0;justify-content:center}}

  .toast{position:fixed;right:22px;bottom:22px;z-index:100;padding:13px 16px;border-radius:11px;background:var(--ink);color:#fff;font-size:12px;font-weight:700;opacity:0;pointer-events:none;transform:translateY(8px);transition:.2s}
  .toast.show{opacity:1;transform:none}
  @media (max-width:600px){ .wrap{padding:12px 12px 90px} .card input,.card textarea,.card select{font-size:16px} }
  @media print{ .nav,.toast{display:none!important} }
</style>
</head>
<body>

<div class="wrap">

  <div class="nav" id="nav">
    <button data-view="tasks" class="on">Tasks</button>
    <button data-view="records">Records</button>
    <button data-view="qr">QR Codes</button>
  </div>

  <!-- ===== TASKS (builder) ===== -->
  <div id="tasksView">
    <div class="cl-topbar">
      <label>RESIDENCE<select id="bHomeSel"></select></label>
      <label>SHOW TASKS<select id="bFreq"><option value="">All frequencies</option><option>Bi-Weekly</option><option>Bi-Monthly</option><option>Annual</option></select></label>
    </div>
    <div class="cl-add">
      <input type="text" id="bName" placeholder="Task name">
      <select id="bAddFreq"><option>Bi-Weekly</option><option>Bi-Monthly</option><option>Annual</option></select>
      <input type="text" id="bSection" placeholder="Section">
      <button class="btn btn-teal" id="bAdd">Add task</button>
    </div>
    <div class="cl-builder">
      <div class="cl-pane">
        <div class="cl-pane-h">Active tasks <span class="cl-cnt" id="bActiveN">0</span></div>
        <div class="cl-list" id="bActive"></div>
      </div>
      <div class="cl-mid">
        <button id="bMoveAdd">« Add</button>
        <button id="bMoveRemove">Remove »</button>
        <button id="bAddAll">Add all</button>
        <button id="bRemoveAll">Remove all</button>
      </div>
      <div class="cl-pane">
        <div class="cl-pane-h">Removed <span class="cl-cnt" id="bRemovedN">0</span></div>
        <div class="cl-list" id="bRemoved"></div>
      </div>
    </div>
  </div>

  <!-- ===== RECORDS ===== -->
  <div id="recordsView" style="display:none">
    <div class="card">
      <h2>Checklist Records</h2>
      <p class="lab">Shared register — every Area Coordinator checklist submission is listed here.</p>
      <div class="filters">
        <input type="text" id="recSearch" placeholder="Search by name…">
        <select id="recResidence"><option value="">All residences</option></select>
        <select id="recCycle"><option value="">All cycles</option><option>Bi-Weekly</option><option>Bi-Monthly</option><option>Annual</option></select>
      </div>
      <table><thead><tr><th>Name</th><th>Residence</th><th>Cycle</th><th>Done</th><th>Signed</th></tr></thead><tbody id="recBody"></tbody></table>
      <div class="empty" id="recEmpty" style="display:none">No checklist submissions yet.</div>
    </div>
  </div>

  <!-- ===== QR CODES ===== -->
  <div id="qrView" style="display:none">
    <div class="card">
      <label class="fld" for="qrHome">Residence</label>
      <select id="qrHome"><option value="">Select a residence…</option></select>
      <label class="fld" for="qrBase">Checklist page link</label>
      <input type="text" id="qrBase" placeholder="https://…/wb-ac-checklist.html">
    </div>
    <div class="card" id="qrPanel" style="margin-top:18px">
      <div class="qrempty" id="qrEmpty">Pick a residence to see its current QR code.</div>
      <div class="qrcard" id="qrCardBox" style="display:none">
        <div class="qname" id="qName"></div>
        <div class="qsince" id="qSince"></div>
        <div class="qrbox" id="qBox"></div>
        <div class="qurl" id="qUrl"></div>
        <div><span class="status" id="qStatus"></span></div>
        <div class="qrow">
          <button class="btn btn-teal" id="qPrint">Print this code</button>
          <button class="btn btn-danger" id="qReset">Reset code (security)</button>
        </div>
        <div class="confirm" id="qConfirm" style="display:none">
          <b>Reset this residence's QR code?</b><br>
          A brand-new code is issued and the code currently posted in the residence <b>stops working immediately</b>. You'll need to print and hang the new one.
          <div class="qrow">
            <button class="btn btn-danger" id="qResetYes">Yes, issue a new code</button>
            <button class="btn btn-ghost" id="qResetNo">Cancel</button>
          </div>
        </div>
        <div class="note">Staff scan this code to open the checklist with the residence filled in. The page checks the code against the active one here, so a reset instantly retires the old printout.</div>
      </div>
    </div>
    <div class="card" id="qrGridCard" style="margin-top:18px">
      <h2>Generate all residences</h2>
      <p class="lab">One QR per residence — generate and print the whole set at once. Uses the same checklist page link above.</p>
      <label class="fld" for="qrHomes">Residences — one per line <span class="fromqr">34 preloaded</span></label>
      <textarea id="qrHomes" style="min-height:150px">Bedford Avenue - 3245
East 35th St - 1431
New York Avenue
Avenue I - 2802
1503 East 14th Street
Avenue H - 824
East 7th Street (Ave N)
46th Street - 1771 1st Fl
46th Street - 1771 2nd Fl
1068 East 14th Street
50th Street - 918
East 9th - 1367
Avenue K - 1010
Crown Heights - 580
Montgomery St (fmr Kingston Ave)
Coney Island Ave - 2173
Avenue L - 1122
East 21 - 2102 Ave I
East 36th Street - 3521
Kings Highway - 2416
53rd Street - 1038
19th Avenue - 4801
46th Street - 1327
48th Street - 1268
Avenue J - 1010
Avenue J - 1014 6B
Avenue J - 1014 6F
Ditmas Avenue - 804
Webster Avenue - 373
East 8th Street - 536
Avenue S
Mill Basin
Staten Island
East 13th Street - 1857</textarea>
      <div class="row">
        <button class="btn btn-teal" id="qrGen">Generate QR codes</button>
        <button class="btn btn-ghost" id="qrPrint" style="display:none">Print all</button>
      </div>
      <div class="qrgrid" id="qrOut"></div>
    </div>
  </div>

</div>

<div class="toast" id="toast"></div>

<script>
/* =========================================================
   CONFIG — shares tables with the checklist app (wb-ac-checklist.html)
   ========================================================= */
const QR_TABLE  = 'ac_qr';
const LIB_TABLE = 'ac_library';
const OFF_TABLE = 'ac_home_off';
const SUB_TABLE = 'cl_submissions';

const $ = id => document.getElementById(id);
const esc = s => (s==null?'':String(s)).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
function getSB(){
  if(window.__hascClient) return window.__hascClient;
  if(window.supabase && window.HASC_CONFIG && window.HASC_CONFIG.SUPABASE_URL){
    try{ window.__hascClient = window.supabase.createClient(window.HASC_CONFIG.SUPABASE_URL, window.HASC_CONFIG.SUPABASE_ANON_KEY); return window.__hascClient; }
    catch(e){ return null; }
  }
  return null;
}
const SB = getSB();
function newToken(){ const a=new Uint8Array(8); (window.crypto||{}).getRandomValues ? window.crypto.getRandomValues(a) : a.forEach((_,i)=>a[i]=Math.floor(Math.random()*256)); return Array.from(a,b=>('0'+b.toString(16)).slice(-2)).join(''); }
function cleanBase(b){ return (b||'').trim().replace(/[?#].*$/,'').replace(/\/+$/,''); }
function toast(m){ const t=$('toast'); t.textContent=m; t.classList.add('show'); clearTimeout(window.__tt); window.__tt=setTimeout(()=>t.classList.remove('show'),1900); }
const fmt = d => { try{ return new Date(d).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})+' · '+new Date(d).toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'}); }catch(e){ return ''; } };

const HOMES = ["Bedford Avenue - 3245","East 35th St - 1431","New York Avenue","Avenue I - 2802","1503 East 14th Street","Avenue H - 824","East 7th Street (Ave N)","46th Street - 1771 1st Fl","46th Street - 1771 2nd Fl","1068 East 14th Street","50th Street - 918","East 9th - 1367","Avenue K - 1010","Crown Heights - 580","Montgomery St (fmr Kingston Ave)","Coney Island Ave - 2173","Avenue L - 1122","East 21 - 2102 Ave I","East 36th Street - 3521","Kings Highway - 2416","53rd Street - 1038","19th Avenue - 4801","46th Street - 1327","48th Street - 1268","Avenue J - 1010","Avenue J - 1014 6B","Avenue J - 1014 6F","Ditmas Avenue - 804","Webster Avenue - 373","East 8th Street - 536","Avenue S","Mill Basin","Staten Island","East 13th Street - 1857"];

/* built-in seed (used in preview, or until ac_library is populated) */
const SEED = [
  ['bw1','Bi-Weekly','GENERAL REVIEW','Visited each home weekly'],
  ['bw2','Bi-Weekly','GENERAL REVIEW','Reviewed weekly to see if there were any new Pons'],
  ['bw3','Bi-Weekly','GENERAL REVIEW','Reviewed weekly any blue forms that were completed.'],
  ['bw4','Bi-Weekly','GENERAL REVIEW','If any falls occurred need to ensure all forms completed correctly sent in to QA.'],
  ['bw5','Bi-Weekly','GENERAL REVIEW','Reviewed the overtime reports with each manager'],
  ['bw6','Bi-Weekly','GENERAL REVIEW','Reviewed any staffing issues'],
  ['bw7','Bi-Weekly','GENERAL REVIEW','Reviewed weekly the current needs of each home'],
  ['bw8','Bi-Weekly','GENERAL REVIEW','Reading and correcting any issues with Fire Drills'],
  ['bw9','Bi-Weekly','GENERAL REVIEW','Checked the medication inventory forms are done and uploaded'],
  ['bw10','Bi-Weekly','WEEKLY MANAGER MEETING','Any issues with individuals'],
  ['bw11','Bi-Weekly','WEEKLY MANAGER MEETING','Any issues with staff'],
  ['bw12','Bi-Weekly','WEEKLY MANAGER MEETING','Any medical appointments'],
  ['bw13','Bi-Weekly','WEEKLY MANAGER MEETING','Any necessary medical follow up'],
  ['bw14','Bi-Weekly','ONE DRIVE DOCUMENTATION','Sunday Activities are happening'],
  ['bw15','Bi-Weekly','ONE DRIVE DOCUMENTATION','Sunday Activities form has been uploaded'],
  ['bw16','Bi-Weekly','ONE DRIVE DOCUMENTATION','the Life Plan Tracker is up to date'],
  ['bw17','Bi-Weekly','ONE DRIVE DOCUMENTATION','Up loading Life Plans'],
  ['bw18','Bi-Weekly','ONE DRIVE DOCUMENTATION','Making sure Fire Drill documentation was up loaded'],
  ['bm1','Bi-Monthly','GENERAL REVIEW','Bi-monthly clinical meeting'],
  ['bm2','Bi-Monthly','GENERAL REVIEW','Conducted a follow up to the clinical meeting to make sure assignments are being done'],
  ['bm3','Bi-Monthly','GENERAL REVIEW','Reviewed one PONS from each home to ensure it is correct and staff have been properly trained.'],
  ['bm4','Bi-Monthly','GENERAL REVIEW','Random spot check for the medex to ensure that everything is signed.'],
  ['bm5','Bi-Monthly','GENERAL REVIEW','Medisked notes reviewed — choose two individuals from each home'],
  ['bm6','Bi-Monthly','GENERAL REVIEW','Reviewed staff trainings'],
  ['bm7','Bi-Monthly','GENERAL REVIEW','Reviewed that the van logs'],
  ['bm8','Bi-Monthly','GENERAL REVIEW','Reviewed water temperature log'],
  ['an1','Annual','GENERAL REVIEW','Reviewed all assessments'],
  ['an2','Annual','GENERAL REVIEW','Reviewed fire evacuation plan'],
  ['an3','Annual','GENERAL REVIEW','Obtained Consent for psychotropic'],
  ['an4','Annual','GENERAL REVIEW','Missing persons'],
  ['an5','Annual','GENERAL REVIEW','Conducted a 25 % review of each homes personal allowance record']
];

/* =========================================================
   VIEW SWITCHING
   ========================================================= */
function setView(v){
  Array.prototype.forEach.call($('nav').querySelectorAll('button'), b=>b.classList.toggle('on', b.dataset.view===v));
  $('tasksView').style.display='none'; $('recordsView').style.display='none'; $('qrView').style.display='none';
  if(v==='tasks'){ $('tasksView').style.display='block'; loadOff(bHomeVal).then(renderBuilder); }
  else if(v==='records'){ $('recordsView').style.display='block'; loadRecords(); }
  else if(v==='qr'){
    $('qrView').style.display='block';
    if(!$('qrBase').value) $('qrBase').value = location.origin + location.pathname.replace(/[^\/]*$/, 'wb-ac-checklist.html');
  }
}
Array.prototype.forEach.call($('nav').querySelectorAll('button'), b=>b.addEventListener('click', ()=>setView(b.dataset.view)));

/* =========================================================
   TASK BUILDER
   ========================================================= */
let library = SEED.map(t=>({id:t[0], freq:t[1], section:t[2], name:t[3]}));
let homeOff = {};
function offSet(h){ if(!homeOff[h]) homeOff[h]=new Set(); return homeOff[h]; }
function fillHomeSelect(sel){ HOMES.forEach(h=>{ const o=document.createElement('option'); o.value=h; o.textContent=h; sel.appendChild(o); }); }
let bHomeVal = HOMES[0];
fillHomeSelect($('bHomeSel')); $('bHomeSel').value = bHomeVal;
fillHomeSelect($('qrHome'));

async function loadLibrary(){
  if(!SB) return;
  try{ const { data } = await SB.from(LIB_TABLE).select('id,frequency,section,task_name,sort_order').order('sort_order'); if(data && data.length) library = data.map(r=>({id:String(r.id), freq:r.frequency, section:r.section||'GENERAL', name:r.task_name})); }catch(e){}
}
const bLoaded = {};
async function loadOff(home){
  if(!SB || !home || bLoaded[home]) return;
  bLoaded[home]=true;
  try{ const { data } = await SB.from(OFF_TABLE).select('task_id').eq('home_name',home); (data||[]).forEach(r=>offSet(home).add(String(r.task_id))); }catch(e){}
}
function optHTML(t){ return '<label class="cl-opt"><input type="checkbox" data-id="'+esc(t.id)+'"><span class="cl-name">'+esc(t.name)+'</span><span class="cl-tag">'+esc(t.freq)+' · '+esc(t.section||'GENERAL')+'</span></label>'; }
function renderBuilder(){
  const filt=$('bFreq').value, off=offSet(bHomeVal);
  const active =library.filter(t=>!off.has(t.id) && (!filt||t.freq===filt));
  const removed=library.filter(t=> off.has(t.id) && (!filt||t.freq===filt));
  $('bActive').innerHTML  = active.length  ? active.map(optHTML).join('')  : '<div class="cl-empty">No active tasks.</div>';
  $('bRemoved').innerHTML = removed.length ? removed.map(optHTML).join('') : '<div class="cl-empty">Nothing removed.</div>';
  $('bActiveN').textContent = active.length; $('bRemovedN').textContent = removed.length;
}
function checkedIds(paneId){ return Array.prototype.map.call(document.querySelectorAll('#'+paneId+' input:checked'), i=>i.dataset.id); }
async function moveOff(ids, off){
  const set=offSet(bHomeVal);
  if(off){ ids.forEach(id=>set.add(id)); if(SB&&ids.length){ try{ await SB.from(OFF_TABLE).upsert(ids.map(id=>({home_name:bHomeVal, task_id:id})),{onConflict:'home_name,task_id'}); }catch(e){} } }
  else   { ids.forEach(id=>set.delete(id)); if(SB&&ids.length){ try{ for(const id of ids){ await SB.from(OFF_TABLE).delete().eq('home_name',bHomeVal).eq('task_id',id); } }catch(e){} } }
  renderBuilder();
}
$('bMoveRemove').addEventListener('click', ()=>moveOff(checkedIds('bActive'), true));
$('bMoveAdd').addEventListener('click',    ()=>moveOff(checkedIds('bRemoved'), false));
$('bRemoveAll').addEventListener('click',  ()=>{ const filt=$('bFreq').value, off=offSet(bHomeVal); moveOff(library.filter(t=>!off.has(t.id)&&(!filt||t.freq===filt)).map(t=>t.id), true); });
$('bAddAll').addEventListener('click',     ()=>{ const filt=$('bFreq').value, off=offSet(bHomeVal); moveOff(library.filter(t=> off.has(t.id)&&(!filt||t.freq===filt)).map(t=>t.id), false); });
$('bAdd').addEventListener('click', async ()=>{
  const name=$('bName').value.trim(); if(!name){ toast('Enter a task name.'); return; }
  const freq=$('bAddFreq').value, section=(($('bSection').value||'').trim().toUpperCase())||'GENERAL';
  const id='ac'+Date.now().toString(36);
  library.push({id, freq, section, name});
  if(SB){ try{ await SB.from(LIB_TABLE).insert({id, frequency:freq, section, task_name:name}); }catch(e){} }
  $('bName').value=''; $('bSection').value=''; renderBuilder(); toast('Task added');
});
$('bFreq').addEventListener('change', renderBuilder);
$('bHomeSel').addEventListener('change', async e=>{ bHomeVal=e.target.value; await loadOff(bHomeVal); renderBuilder(); });

/* =========================================================
   RECORDS
   ========================================================= */
let REC = [];
const AC_FREQS = { 'bi-weekly':1, 'bi-monthly':1, 'annual':1 };
async function loadRecords(){
  const body=$('recBody'); body.innerHTML=''; $('recEmpty').style.display='none';
  if(!SB){ $('recEmpty').textContent='Records load once the app is published on the HASC site.'; $('recEmpty').style.display='block'; return; }
  try{
    const { data, error } = await SB.from(SUB_TABLE).select('*').order('submitted_at',{ascending:false}).limit(1000);
    if(error){ $('recEmpty').textContent='Could not load records — '+error.message; $('recEmpty').style.display='block'; return; }
    REC = (data||[]).filter(r=>AC_FREQS[(r.frequency||'').toLowerCase()]);
    const homes=[...new Set(REC.map(r=>r.home_name).filter(Boolean))].sort();
    $('recResidence').innerHTML='<option value="">All residences</option>'+homes.map(h=>'<option value="'+esc(h)+'">'+esc(h)+'</option>').join('');
    drawRecords();
  }catch(e){ $('recEmpty').textContent='Could not load records — check connection.'; $('recEmpty').style.display='block'; }
}
function drawRecords(){
  const q=($('recSearch').value||'').toLowerCase().trim(), res=$('recResidence').value, cyc=($('recCycle').value||'').toLowerCase();
  const rows = REC.filter(r=>{ const name=(r.submitted_by||r.signature||'').toLowerCase(); return (!q||name.indexOf(q)!==-1) && (!res||r.home_name===res) && (!cyc||(r.frequency||'').toLowerCase()===cyc); });
  const body=$('recBody');
  if(!rows.length){ body.innerHTML=''; $('recEmpty').textContent = REC.length?'No matching submissions.':'No checklist submissions yet.'; $('recEmpty').style.display='block'; return; }
  $('recEmpty').style.display='none';
  const cap = s => (s||'').charAt(0).toUpperCase()+(s||'').slice(1);
  body.innerHTML = rows.map(r=>'<tr><td>'+esc(r.submitted_by||r.signature||'')+'</td><td>'+esc(r.home_name||'')+'</td><td>'+esc(cap(r.frequency||''))+'</td><td>'+(r.tasks_done||0)+' / '+(r.tasks_total||0)+'</td><td>'+(r.submitted_at?fmt(r.submitted_at):'')+'</td></tr>').join('');
}
$('recSearch').addEventListener('input', drawRecords);
$('recResidence').addEventListener('change', drawRecords);
$('recCycle').addEventListener('change', drawRecords);

/* =========================================================
   QR CODES — single residence
   ========================================================= */
function qrSvg(url){ const qr=qrcode(0,'M'); qr.addData(url); qr.make(); return qr.createSvgTag(6,0); }
function qrUrl(home,token){ return cleanBase($('qrBase').value) + '?home=' + encodeURIComponent(home) + '&t=' + encodeURIComponent(token); }
let curQR = { home:'', token:'' };
function renderQRCard(home,token){ curQR={home,token}; const url=qrUrl(home,token); $('qBox').innerHTML=qrSvg(url); $('qName').textContent=home; $('qUrl').textContent=url; }
async function loadHomeQR(home){
  $('qrEmpty').style.display='none'; $('qrCardBox').style.display='block'; $('qConfirm').style.display='none';
  $('qSince').textContent='Loading…'; $('qStatus').textContent='';
  if(!SB){ const tok=newToken(); renderQRCard(home,tok); $('qSince').textContent='Preview code'; $('qStatus').className='status preview'; $('qStatus').textContent='Preview — not saved (publish / sign in to issue)'; return; }
  try{
    const { data, error } = await SB.from(QR_TABLE).select('token,updated_at').eq('home_name',home).maybeSingle();
    if(error) throw error;
    if(data && data.token){ renderQRCard(home,data.token); $('qSince').innerHTML='Active code · issued <b>'+esc(fmt(data.updated_at))+'</b>'; $('qStatus').className='status saved'; $('qStatus').textContent='Active & saved'; }
    else{ const tok=newToken(); const up=await SB.from(QR_TABLE).upsert({home_name:home,token:tok,updated_at:new Date().toISOString()},{onConflict:'home_name'}); if(up.error) throw up.error; renderQRCard(home,tok); $('qSince').innerHTML='Active code · issued <b>just now</b>'; $('qStatus').className='status saved'; $('qStatus').textContent='Active & saved'; }
  }catch(e){ const tok=newToken(); renderQRCard(home,tok); $('qSince').textContent='Code shown (not saved)'; $('qStatus').className='status err'; $('qStatus').textContent='Couldn\u2019t reach the database — '+(e.message||'sign in on the HASC site'); }
}
async function resetHomeQR(){
  const home=curQR.home; if(!home) return; const tok=newToken();
  if(!SB){ renderQRCard(home,tok); $('qConfirm').style.display='none'; $('qStatus').className='status preview'; $('qStatus').textContent='Preview — not saved'; toast('New preview code (not saved)'); return; }
  try{ const up=await SB.from(QR_TABLE).upsert({home_name:home,token:tok,updated_at:new Date().toISOString()},{onConflict:'home_name'}); if(up.error) throw up.error; renderQRCard(home,tok); $('qSince').innerHTML='Active code · issued <b>just now</b>'; $('qStatus').className='status saved'; $('qStatus').textContent='Active & saved'; $('qConfirm').style.display='none'; toast('New code issued — old one retired'); }
  catch(e){ $('qStatus').className='status err'; $('qStatus').textContent='Reset failed — '+(e.message||'sign in and try again'); toast('Reset failed'); }
}
function printQRCode(){
  if(!curQR.home) return; const svg=$('qBox').innerHTML;
  let win=null; try{ win=window.open('','_blank'); }catch(e){}
  if(!win){ window.print(); return; }
  win.document.write('<!DOCTYPE html><html><head><meta charset="utf-8"><title>'+esc(curQR.home)+'</title>'+
    '<style>body{font-family:-apple-system,Segoe UI,Arial,sans-serif;text-align:center;padding:48px 24px;color:#1f2d33}h1{font-size:28px;margin:0 0 4px}.sub{color:#5c6b72;font-size:14px;margin-top:8px}svg{width:340px;height:340px}.u{color:#9fb0b8;font-size:10px;word-break:break-all;max-width:460px;margin:16px auto 0}@page{margin:16mm}</style></head><body>'+
    '<h1>'+esc(curQR.home)+'</h1>'+svg+'<div class="sub">Scan to open the Area Coordinator checklist</div><div class="u">'+esc($('qUrl').textContent)+'</div></body></html>');
  win.document.close(); win.focus(); setTimeout(()=>{ try{ win.print(); }catch(e){} }, 350);
}
$('qrHome').addEventListener('change', e=>{ const h=e.target.value; if(h) loadHomeQR(h); else { $('qrCardBox').style.display='none'; $('qrEmpty').style.display='block'; } });
$('qrBase').addEventListener('input', ()=>{ if(curQR.home && curQR.token) renderQRCard(curQR.home,curQR.token); });
$('qReset').addEventListener('click', ()=>{ $('qConfirm').style.display='block'; });
$('qResetNo').addEventListener('click', ()=>{ $('qConfirm').style.display='none'; });
$('qResetYes').addEventListener('click', resetHomeQR);
$('qPrint').addEventListener('click', printQRCode);

/* =========================================================
   QR CODES — all residences at once
   ========================================================= */
async function tokensFor(homes){
  const map={};
  if(SB){
    try{
      const { data } = await SB.from(QR_TABLE).select('home_name,token');
      (data||[]).forEach(r=>{ map[r.home_name]=r.token; });
      const missing=homes.filter(h=>!map[h]).map(h=>({home_name:h,token:newToken(),updated_at:new Date().toISOString()}));
      if(missing.length){ await SB.from(QR_TABLE).upsert(missing,{onConflict:'home_name'}); missing.forEach(m=>map[m.home_name]=m.token); }
    }catch(e){}
  }
  homes.forEach(h=>{ if(!map[h]) map[h]=newToken(); });
  return map;
}
let bulkCards=[];
function gcardHTML(name,url,svg){ return '<div class="gname">'+esc(name)+'</div>'+svg+'<div class="gurl">'+esc(url)+'</div><button class="greset" data-home="'+esc(name)+'">↻ Reset code</button>'; }
async function generateAll(){
  const base=cleanBase($('qrBase').value); if(!base){ toast('Enter the checklist page link first.'); return; }
  const homes=$('qrHomes').value.split('\n').map(s=>s.trim()).filter(Boolean); if(!homes.length){ toast('Enter at least one residence.'); return; }
  const out=$('qrOut'); out.innerHTML='<div class="cl-empty">Generating…</div>';
  const map=await tokensFor(homes); bulkCards=[]; out.innerHTML='';
  homes.forEach(name=>{ const url=qrUrl(name,map[name]), svg=qrSvg(url); bulkCards.push({name,url,svg}); const card=document.createElement('div'); card.className='qrgcard'; card.innerHTML=gcardHTML(name,url,svg); out.appendChild(card); });
  Array.prototype.forEach.call(out.querySelectorAll('.greset'), b=>b.addEventListener('click', ()=>resetInGrid(b.dataset.home)));
  $('qrPrint').style.display='inline-flex';
  if(!SB) toast('Preview codes — not saved (publish / sign in to issue)');
}
async function resetInGrid(home){
  const tok=newToken();
  if(SB){ try{ const up=await SB.from(QR_TABLE).upsert({home_name:home,token:tok,updated_at:new Date().toISOString()},{onConflict:'home_name'}); if(up.error) throw up.error; }catch(e){ toast('Reset failed — '+(e.message||'sign in and try again')); return; } }
  const url=qrUrl(home,tok), svg=qrSvg(url); const i=bulkCards.findIndex(c=>c.name===home); if(i>=0) bulkCards[i]={name:home,url,svg};
  Array.prototype.forEach.call($('qrOut').querySelectorAll('.qrgcard'), card=>{ const n=card.querySelector('.gname'); if(n && n.textContent===home){ card.innerHTML=gcardHTML(home,url,svg); card.querySelector('.greset').addEventListener('click', ()=>resetInGrid(home)); } });
  toast(SB?'New code issued — old one retired':'New preview code (not saved)');
}
function printAllQR(){
  if(!bulkCards.length) return;
  let win=null; try{ win=window.open('','_blank'); }catch(e){}
  if(!win){ window.print(); return; }
  const cards=bulkCards.map(c=>'<div class="c"><div class="n">'+esc(c.name)+'</div>'+c.svg+'<div class="sub">Scan to open the Area Coordinator checklist</div><div class="u">'+esc(c.url)+'</div></div>').join('');
  win.document.write('<!DOCTYPE html><html><head><meta charset="utf-8"><title>Checklist QR codes</title>'+
    '<style>body{font-family:-apple-system,Segoe UI,Arial,sans-serif;color:#1f2d33;margin:0;padding:16px}.g{display:flex;flex-wrap:wrap;gap:20px;justify-content:center}.c{width:300px;text-align:center;page-break-inside:avoid;border:1px solid #e3ebee;border-radius:12px;padding:18px}.c .n{font-weight:700;font-size:16px;margin-bottom:8px}.c svg{width:220px;height:220px}.c .sub{color:#5c6b72;font-size:12px;margin-top:6px}.c .u{font-size:9px;color:#9fb0b8;word-break:break-all;margin-top:6px}@page{margin:12mm}</style></head><body><div class="g">'+cards+'</div></body></html>');
  win.document.close(); win.focus(); setTimeout(()=>{ try{ win.print(); }catch(e){} }, 400);
}
$('qrGen').addEventListener('click', generateAll);
$('qrPrint').addEventListener('click', printAllQR);

/* =========================================================
   BOOT
   ========================================================= */
(async function boot(){
  await loadLibrary();
  await loadOff(bHomeVal);
  setView('tasks');
})();
</script>
