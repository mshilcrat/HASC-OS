function openStaff(num,home){
  const s=DATA.find(x=>x.num===num); if(!s) return;
  const slot=(home?s.res.find(r=>r.res===home):s.res[0])||{res:'',trainings:[]};
  const trs=slot.trainings.slice().sort((a,b)=>(b.d||'').localeCompare(a.d||''));
  const last=trs[0]?trs[0].d:'';
  const d=document.getElementById('drawer');
  d.innerHTML=`
    <div class="dh"><div class="who"><span class="ini">${esc(ini(s.name))}</span>
      <div><h2>${esc(s.name)}</h2><div class="sub">${esc(slot.res||'')}</div></div>
      <button class="x" onclick="closeDrawer()">&#10005;</button></div>
      <div class="dstats">
        <div class="dstat"><b>${trs.length}</b><span>Completions</span></div>
        <div class="dstat"><b style="font-size:13px">${esc(fmtDate(last)||'—')}</b><span>Last</span></div>
        <div class="dstat"><b style="font-size:13px">${esc(s.num)}</b><span>Emp #</span></div>
