async function addStaff(){
  const num=document.getElementById('f_num').value.trim();
  const name=document.getElementById('f_name').value.trim();
  const title=document.getElementById('f_title').value.trim();
  const res=document.getElementById('f_res').value;
  if(!num||!name){toast('Employee # and name are required');return;}
  if(DATA.some(s=>s.num===num)){toast('That employee # already exists');return;}
  const ac=(RES_CATALOG.find(c=>c.res===res)||{}).ac||'';
  const rec={num,name,title,res:[{res,ac,trained:false,trainings:[]}]};
  DATA.push(rec);
  if(liveOn()){const {error}=await SB.from(STAFF_TABLE).insert({employee_number:num,staff_name:name,name_key:name.toLowerCase(),position_title:title,residence:res,area_coordinator:ac});if(error){toast('Saved locally; Supabase: '+error.message);}}
  toast('Added '+name);
  go('manage');
}
async function removeStaff(num,name){
  if(!confirm('Remove '+name+' from the roster?'))return;
  DATA=DATA.filter(s=>s.num!==num);
  if(liveOn()){const {error}=await SB.from(STAFF_TABLE).delete().eq('employee_number',num);if(error){toast('Removed locally; Supabase: '+error.message);}}
  toast('Removed '+name);
  go('manage');
}

function staffRow(s,home,slot){
  const c=slot.trainings.length;
  return `<button class="staffrow" onclick="openStaff('${jsStr(s.num)}','${jsStr(home)}')">
     <span class="ini">${esc(ini(s.name))}</span><span class="nm">${esc(s.name)}</span>
     <span class="ct${c?'':' zero'}">${c}</span></button>`;
}
function resAcc(home,people,open){
  people=people.slice().sort((a,b)=>(b.slot.trainings.length-a.slot.trainings.length)||a.s.name.localeCompare(b.s.name));
  const comp=people.reduce((n,p)=>n+p.slot.trainings.length,0);
  const names=people.map(p=>p.s.name.toLowerCase()).join('|');
  return `<section class="acc ${open?'open':''}" data-key="${esc(home.toLowerCase())}" data-names="${esc(names)}">
    <button class="acc-h" onclick="this.closest('.acc').classList.toggle('open')"><span class="chev">&#9654;</span>
      <span class="ah"><h3>${esc(home)}</h3><div class="meta">${people.length} staff &middot; ${comp} completions</div></span></button>
    <div class="acc-b"><div class="accgrid">${people.map(p=>staffRow(p.s,home,p.slot)).join('')}</div></div>
  </section>`;
}
function acAcc(ac,rows,open){
  rows=rows.slice().sort((a,b)=>(a.slot.trained-b.slot.trained)||a.s.name.localeCompare(b.s.name));
  const done=rows.filter(x=>x.slot.trained).length, tot=rows.length;
  const names=rows.map(x=>x.s.name.toLowerCase()).join('|');
  return `<section class="acc ${open?'open':''}" data-key="${esc(ac.toLowerCase())}" data-names="${esc(names)}">
    <button class="acc-h" onclick="this.closest('.acc').classList.toggle('open')"><span class="chev">&#9654;</span>
      <span class="ah"><h3>${esc(ac)}</h3><div class="meta">${done} of ${tot} trained</div></span>
      <span class="bar"><i style="width:${pct(done,tot)}%"></i></span></button>
    <div class="acc-b"><div class="accgrid">${rows.map(x=>staffRow(x.s,x.slot.res,`<span class="status ${x.slot.trained?'done':'gap'}">${x.slot.trained?'Trained':'Not yet'}</span>`,x.slot.res)).join('')}</div></div>
  </section>`;
}
function filterAcc(v){v=v.trim().toLowerCase();document.querySelectorAll('#acc .acc').forEach(c=>{const hit=!v||c.dataset.key.includes(v)||c.dataset.names.includes(v);c.style.display=hit?'block':'none';if(v&&hit)c.classList.add('open');});}
function allAcc(open){document.querySelectorAll('#acc .acc').forEach(c=>c.classList.toggle('open',open));}

