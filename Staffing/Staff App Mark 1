const NAV=[{group:'Training',items:[
  ['overview','Overview','i-home','#17a2b8'],
  ['homes','By Residence','i-grid','#4E86C9']
]},{group:'Admin',items:[
  ['manage','Manage Staff','i-people','#C96A44']
]}];
function buildRail(){document.getElementById('rail').innerHTML=NAV.map(g=>`<div class="rail-label">${g.group}</div><nav class="nav">${g.items.map(it=>`<button class="navbtn" data-id="${it[0]}" onclick="go('${it[0]}')"><span class="nav-ic" style="--tile:${it[3]}"><svg><use href="#${it[2]}"/></svg></span><span>${it[1]}</span></button>`).join('')}</nav>`).join('');}
let CURRENT={id:'overview',opts:undefined};
function refresh(){go(CURRENT.id,CURRENT.opts);}
function go(id,opts){CURRENT={id,opts};document.getElementById('view').innerHTML=VIEWS[id](opts);document.querySelectorAll('.navbtn').forEach(b=>b.classList.toggle('active',b.dataset.id===id));if(!opts||opts.q===undefined)document.querySelector('.wrap').scrollTop=0;const q=document.getElementById('q');if(q&&opts&&opts.q!==undefined){q.focus();q.setSelectionRange(q.value.length,q.value.length);}}

/* ---------- live ---------- */
async function goLive(){
  if(!liveOn()) return;
  SB=supabase.createClient(SUPABASE_URL,SUPABASE_ANON_KEY);
  const {data,error}=await SB.from(STAFF_TABLE).select('*');
  if(error){console.warn('live fetch failed, staying on seed:',error.message);return;}
  DATA=data.length?data:DATA; refresh();
  document.getElementById('livedot').classList.add('on');
  document.getElementById('livedot').title='Live — '+data.length+' staff';
}

(async function init(){
  tick();setInterval(tick,1000);
  DATA=await loadStaff();
  buildRail(); go('overview');
  goLive();
})();
</script>
