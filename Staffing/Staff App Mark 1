function trainedAnywhere(s){return s.res.some(r=>r.trained)}
function allSlots(){const a=[];DATA.forEach(s=>s.res.forEach(r=>a.push({s,slot:r})));return a;}
function byResidence(){const m=new Map();DATA.forEach(s=>s.res.forEach(r=>{if(!m.has(r.res))m.set(r.res,[]);m.get(r.res).push({s,slot:r})}));return m;}
function byAC(){const m=new Map();allSlots().forEach(x=>{const a=x.slot.ac||'—';if(!m.has(a))m.set(a,[]);m.get(a).push(x)});return m;}
function pct(a,b){return b?Math.round(a/b*100):0}

