<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>HASC OS — Staff Training</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root{--ink:#24313a;--muted:#75828b;--line:#e2e5e2;--paper:#f3f0e9;--white:#fff;--teal:#159aaa;--teal2:#0d7d8c;--brandteal:#37C1CF;--brandyellow:#F5CF01;--done:#178a6d;--gap:#c0523c}
*{box-sizing:border-box}html,body{height:100%;margin:0}
body{font-family:'Plus Jakarta Sans',sans-serif;background:var(--paper);color:var(--ink);overflow:hidden}
button{font:inherit}
.shell{height:100vh;display:grid;grid-template-rows:auto 1fr}
.topbar{background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;padding:0 22px;height:60px;box-shadow:0 2px 10px rgba(28,43,51,.035);z-index:6}
.logo{height:30px;width:auto;display:block}
.divi{height:26px;width:1px;background:var(--line);margin:0 16px}
.product{font-size:13px;font-weight:800;color:#5c6b74;letter-spacing:-.01em}
.product b{color:var(--teal2)}
.top-right{margin-left:auto;display:flex;align-items:center;gap:14px}
.livedot{width:8px;height:8px;border-radius:50%;background:#c2ccd0;box-shadow:0 0 0 3px #eef1f0}
.livedot.on{background:#4fa07a;box-shadow:0 0 0 3px #e2f3ea}
.clock{font-size:11px;color:var(--muted);font-weight:700}
.avatar{width:34px;height:34px;border-radius:10px;background:var(--teal);display:grid;place-items:center;color:#fff;font-weight:800;font-size:12px}
.toast{position:fixed;right:22px;bottom:22px;background:#263841;color:#fff;border-radius:9px;padding:11px 15px;font-size:11px;font-weight:700;box-shadow:0 8px 24px rgba(0,0,0,.2);z-index:60}

.main{min-height:0;display:grid;grid-template-columns:230px minmax(0,1fr)}
.rail{background:#fff;border-right:1px solid #e7e2d9;padding:16px 12px;overflow:auto;min-height:0}
.rail-label{font-size:10px;color:#9fb0b8;letter-spacing:.16em;font-weight:900;text-transform:uppercase;padding:14px 10px 7px}
.rail-label:first-child{padding-top:2px}
.nav{display:grid;gap:3px}
.navbtn{width:100%;min-height:40px;border:0;background:transparent;border-radius:10px;padding:8px 10px;display:flex;align-items:center;gap:11px;text-align:left;color:#3a4a54;font-size:12.5px;font-weight:700;cursor:pointer;line-height:1.15}
.navbtn:hover{background:#f1efe9}
.navbtn.active{background:#e8f6f8;color:#0f7d8f}
.nav-ic{width:28px;height:28px;border-radius:8px;display:grid;place-items:center;flex:none;color:#fff;background:var(--tile,#17a2b8);box-shadow:0 6px 13px -7px var(--tile,#17a2b8)}
.nav-ic svg{width:16px;height:16px;stroke:#fff;fill:none;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}

.wrap{min-width:0;min-height:0;overflow:auto;padding:26px 30px 40px}
.crumb{font-size:10px;color:var(--teal);font-weight:900;text-transform:uppercase;letter-spacing:.12em;margin-bottom:7px}
.head{display:flex;align-items:flex-end;gap:16px;margin-bottom:20px}
.head h1{font-size:26px;letter-spacing:-.04em;margin:0}
.head p{font-size:12px;color:var(--muted);margin:5px 0 0;max-width:660px}
.head .right{margin-left:auto;display:flex;gap:8px}
.btn{border:1px solid #cbd7e2;background:#fff;color:#26343d;border-radius:10px;padding:8px 13px;font-size:11px;font-weight:800;cursor:pointer}
.btn:hover{background:#f7fafb}
.btn.on{background:#e8f6f8;border-color:#a9dbe3;color:#0f7d8f}

.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:13px;margin-bottom:22px}
.kpi{background:#fff;border:1px solid #e1e6e8;border-radius:15px;padding:16px 17px;box-shadow:0 5px 16px rgba(37,58,73,.04)}
.kpi .lbl{color:var(--muted);font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.06em}
.kpi b{display:block;font-size:26px;letter-spacing:-.045em;margin-top:8px}
.kpi small{font-size:10px;color:#95a0a6}
.kpi.gap b{color:var(--gap)}

.controls{display:flex;gap:10px;align-items:center;margin-bottom:16px;flex-wrap:wrap}
.controls input{height:40px;border:1px solid #d2dce3;border-radius:11px;padding:0 12px;font-size:12px;color:#40515e;background:#fff;flex:1;max-width:440px}

.acc{background:#fff;border:1px solid #e1e6e8;border-radius:14px;box-shadow:0 5px 16px rgba(37,58,73,.04);margin-bottom:10px;overflow:hidden}
.acc-h{display:flex;align-items:center;gap:13px;width:100%;border:0;background:#fff;padding:15px 18px;cursor:pointer;text-align:left}
.acc-h:hover{background:#fbfdfd}
.acc-h .chev{color:#8da1b2;font-weight:900;font-size:11px;transition:transform .18s;flex:none}
.acc.open .acc-h .chev{transform:rotate(90deg)}
.acc-h h3{margin:0;font-size:14px;letter-spacing:-.01em}
.acc-h .ah{flex:1;min-width:0}
.acc-h .meta{font-size:11px;color:var(--muted);font-weight:700;margin-top:2px}
.bar{width:120px;height:7px;border-radius:99px;background:#ecedf0;overflow:hidden;flex:none}
.bar i{display:block;height:100%;background:var(--done)}
.acc-b{display:none;padding:8px 12px 14px;border-top:1px solid #eef0f2;background:#fbfdfd}
.acc.open .acc-b{display:block}
.accgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:2px}

.staffrow{display:flex;align-items:center;gap:10px;padding:9px 10px;border-radius:9px;cursor:pointer;text-align:left;border:0;background:transparent;width:100%}
.staffrow:hover{background:#f1f6f7}
.ini{width:30px;height:30px;border-radius:8px;background:#e8f6f8;color:#0f7d8f;display:grid;place-items:center;font-size:10px;font-weight:900;flex:none}
.staffrow .nm{font-size:12.5px;font-weight:700;color:#33454e;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:1}
.ct{margin-left:auto;font-size:10px;font-weight:900;border-radius:999px;padding:2px 8px;background:#f1efe9;color:#6a7882;flex:none}
.ct.zero{background:#fbe7e2;color:#c0523c}
.form{background:#fff;border:1px solid #e1e6e8;border-radius:15px;box-shadow:0 5px 16px rgba(37,58,73,.04);padding:16px 18px;margin-bottom:18px;display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;align-items:end}
.fld{display:flex;flex-direction:column;gap:5px}
.fld label{font-size:10px;font-weight:800;color:#8a97a0;text-transform:uppercase;letter-spacing:.05em}
.fld input,.fld select{height:40px;border:1px solid #d2dce3;border-radius:10px;padding:0 11px;font-size:12.5px;color:#33454e;background:#fff;font-family:inherit}
.addbtn{height:40px;border:0;border-radius:10px;background:var(--teal);color:#fff;font-weight:800;font-size:12.5px;cursor:pointer;padding:0 18px}
.addbtn:hover{background:var(--teal2)}
.rmv{margin-left:auto;border:1px solid #e6cfca;background:#fff;color:#c0523c;border-radius:8px;font-size:10px;font-weight:900;padding:5px 10px;cursor:pointer;flex:none}
.rmv:hover{background:#fbe7e2}
.status{font-size:9px;font-weight:900;border-radius:999px;padding:3px 9px;flex:none;text-transform:uppercase;letter-spacing:.03em}
.status.done{background:#e4f7ed;color:var(--done)}
.status.gap{background:#fbe7e2;color:var(--gap)}

.tbl{background:#fff;border:1px solid #dfe6e8;border-radius:14px;overflow:hidden;box-shadow:0 5px 16px rgba(37,58,73,.04)}
.tr{display:grid;gap:12px;align-items:center;padding:12px 16px}
.tr.h{background:#f7f9fb;color:#889ab2;font-size:9px;font-weight:900;text-transform:uppercase;letter-spacing:.1em}
.tr.r{border-top:1px solid #eef0f2;font-size:12.5px;color:#3f4d56;cursor:pointer}
.tr.r:hover{background:#f7fafb}
.tr.r strong{font-size:13px;color:#28323a}
.tr .sub{font-size:10.5px;color:#93a0a7}
.empty{padding:24px;text-align:center;color:#85929a;font-size:12px;background:#fff;border:1px dashed #d9e2e6;border-radius:12px}

.scrim{position:fixed;inset:0;background:rgba(28,40,48,.34);opacity:0;pointer-events:none;transition:opacity .2s;z-index:40}
.scrim.on{opacity:1;pointer-events:auto}
.drawer{position:fixed;top:0;right:0;height:100vh;width:430px;max-width:92vw;background:#fff;box-shadow:-14px 0 40px rgba(28,40,48,.14);transform:translateX(100%);transition:transform .24s;z-index:41;display:flex;flex-direction:column}
.drawer.on{transform:none}
.dh{padding:22px 22px 16px;border-bottom:1px solid #eef0f2}
.dh .who{display:flex;align-items:center;gap:12px}
.dh .who .ini{width:44px;height:44px;font-size:14px;border-radius:12px}
.dh h2{margin:0;font-size:18px;letter-spacing:-.02em}
.dh .sub{font-size:11.5px;color:var(--muted);font-weight:700;margin-top:2px}
.dh .x{margin-left:auto;border:0;background:#f1efe9;width:32px;height:32px;border-radius:9px;font-size:16px;cursor:pointer;color:#54636c}
.dstats{display:flex;gap:8px;padding:14px 22px 4px}
.dstat{flex:1;background:#f7f9fb;border:1px solid #eef0f2;border-radius:11px;padding:10px 12px}
.dstat b{display:block;font-size:18px;letter-spacing:-.03em}
.dstat span{font-size:10px;color:var(--muted);font-weight:800;text-transform:uppercase;letter-spacing:.05em}
.dbody{padding:16px 22px 26px;overflow:auto}
.resblock{margin-bottom:16px}
.resblock .rt{display:flex;align-items:center;gap:9px;margin-bottom:8px}
.resblock .rt h4{font-size:12px;color:#33454e;margin:0;font-weight:800;letter-spacing:-.01em}
.trn{display:grid;grid-template-columns:9px 1fr;gap:11px;align-items:start;padding:8px 0;border-top:1px solid #f0f2f3}
.trn:first-of-type{border-top:0}
.trn .dot{width:9px;height:9px;border-radius:50%;background:#4fa07a;margin-top:4px}
.trn .tt{font-size:12px;font-weight:700;color:#33454e;line-height:1.3}
.trn .td{font-size:10.5px;color:var(--muted);font-weight:700;margin-top:2px}
.nogap{font-size:11.5px;color:var(--gap);font-weight:800;background:#fbe7e2;border-radius:9px;padding:9px 12px}

@media(max-width:900px){.main{grid-template-columns:66px minmax(0,1fr)}.rail-label,.navbtn span:not(.nav-ic){display:none}.navbtn{justify-content:center}.bar{display:none}}
</style>
</head>
