{
  "version": 1,
  "purpose": "FRIDAY OT department-to-residence rules",
  "defaults": {
    "unmatchedAction": "flag",
    "ignoreZeroHours": true
  },
  "headerAliases": {
    "department": ["department", "dept", "department name", "dept name", "cost center", "program", "location"],
    "overtime": ["overtime", "ot", "ot hours", "overtime hours", "hours ot", "ot hrs"]
  },
  "rules": [
    {
      "id": "ignore-non-residential",
      "match": { "containsAny": ["administration", "central office", "training department", "human resources"] },
      "action": "ignore",
      "reason": "Non-residential department"
    }
  ],
  "residenceAliases": {}
}
